# NetSense environment variable NAMES. No values here, ever.
# Copy to .env.local (dev) or /data/netsense/.env on the VM (mode 600) and fill in.
# See SETUP.md for where each value comes from. Never commit a filled file.

# --- App ---
NETSENSE_ENV=
APP_BASE_URL=

# --- Clerk (coach auth). Only the publishable key reaches the browser. ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# --- Convex ---
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
CONVEX_SERVICE_SECRET=
WORKER_TOKEN_SECRET=

# --- Meta Model API (Standard mode) ---
MODEL_API_KEY=
META_API_BASE_URL=

# --- Agent provider (DECISION PENDING (Bala) G1: default meta) ---
AGENT_PROVIDER_DEFAULT=
GEMINI_API_KEY=
FIREWORKS_API_KEY=
BASETEN_API_KEY=

# --- Sandbox / Modal ---
SANDBOX_DRIVER=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=
MODAL_RUNNER_SECRET_NAME=
MODAL_ENVIRONMENT=
SANDBOX_TIMEOUT_CAP_S=
SANDBOX_IDLE_TIMEOUT_S=
HEARTBEAT_S=
HEARTBEAT_STALE_S=
JOB_LEASE_S=
JOB_MAX_ATTEMPTS=
ORCH_POLL_INTERVAL_MS=
SWEEPER_INTERVAL_S=
VM_API_BASE_URL=

# --- Storage (S1 decided 28 Oct: r2 is the default; local = dev/test fallback only) ---
STORAGE_DRIVER=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
LOCAL_STORAGE_DIR=
MEDIA_URL_SIGNING_SECRET=
SIGNED_URL_TTL_SECONDS=

# --- Student link (DECISION PENDING (Bala) D4) ---
LINK_CODE_PEPPER=
STUDENT_SESSION_SECRET=
LINK_TTL_DAYS=

# --- Cost guards ---
DAILY_SPEND_LIMIT_USD=
JOB_SAM_FRAME_CAP=
JOB_SPARK_TOKEN_CAP=
FANOUT_CONCURRENCY=
MAX_VIDEO_MINUTES=

# --- Feature flags (cuts, SPEC §17) ---
FEATURE_PRACTICE_PLAN=
FEATURE_FFMPEG_RENDER=
FEATURE_MARK_TYPES=
FEATURE_REVIEW_MODE=
FEATURE_LINK_EXTRAS=
