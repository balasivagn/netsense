{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MomentOutput.json",
  "title": "MomentOutput",
  "type": "object",
  "properties": {
    "remarkId": {
      "type": "string"
    },
    "startMs": {
      "type": "integer",
      "minimum": 0
    },
    "endMs": {
      "type": "integer",
      "minimum": 0
    },
    "keyframeMs": {
      "type": "integer",
      "minimum": 0
    },
    "keyframeIdx": {
      "type": "integer",
      "minimum": 0
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "startMs",
          "endMs"
        ],
        "additionalProperties": false
      },
      "maxItems": 2
    },
    "why": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  },
  "required": [
    "remarkId",
    "startMs",
    "endMs",
    "keyframeMs",
    "keyframeIdx",
    "candidates",
    "why",
    "confidence"
  ],
  "additionalProperties": false
}
