{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SubjectAnchorOutput.json",
  "title": "SubjectAnchorOutput",
  "type": "object",
  "properties": {
    "anchorBox": {
      "$ref": "Common.json#/$defs/Box"
    },
    "anchorFrameMs": {
      "type": "integer",
      "minimum": 0
    },
    "referenceCropKey": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "anchorBox",
    "anchorFrameMs",
    "referenceCropKey",
    "confidence"
  ],
  "additionalProperties": false
}
