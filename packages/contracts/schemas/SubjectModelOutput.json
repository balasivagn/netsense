{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SubjectModelOutput.json",
  "title": "SubjectModelOutput",
  "type": "object",
  "properties": {
    "boxNumber": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "why": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  },
  "required": [
    "boxNumber",
    "why",
    "confidence"
  ],
  "additionalProperties": false
}
