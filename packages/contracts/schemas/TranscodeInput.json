{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TranscodeInput.json",
  "title": "TranscodeInput",
  "type": "object",
  "properties": {
    "uploadId": {
      "type": "string"
    },
    "sourceKey": {
      "type": "string"
    },
    "declaredBytes": {
      "type": "integer",
      "minimum": 0
    },
    "declaredSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mimeType": {
      "type": "string"
    }
  },
  "required": [
    "uploadId",
    "sourceKey",
    "declaredBytes",
    "declaredSha256",
    "mimeType"
  ],
  "additionalProperties": false
}
